{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build jogo (C++)",
      "type": "shell",
      "command": "C:\\MinGW\\bin\\g++.exe",
      "args": [
        "*.cpp",
        "-g",
        "-o",
        "jogo.exe"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": ["$gcc"],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
